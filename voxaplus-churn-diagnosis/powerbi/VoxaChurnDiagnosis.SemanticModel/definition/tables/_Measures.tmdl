	measure 'Target Paid Active Subscribers' = CALCULATE ( SUM ( fact_targets_month[target_value] ), fact_targets_month[kpi] = "paid_active_subscribers", FILTER ( ALL ( dim_date ), dim_date[abs_month] = CALCULATE ( MAX ( dim_date[abs_month] ), REMOVEFILTERS ( dim_date ), dim_date[in_analysis_window] = TRUE ) ) )
		formatString: #,##0
		displayFolder: 11 Targets
		lineageTag: 94a6014d-665e-5151-8c55-f51f211216e5

	measure 'Target MRR' = CALCULATE ( SUM ( fact_targets_month[target_value] ), fact_targets_month[kpi] = "mrr_usd", FILTER ( ALL ( dim_date ), dim_date[abs_month] = CALCULATE ( MAX ( dim_date[abs_month] ), REMOVEFILTERS ( dim_date ), dim_date[in_analysis_window] = TRUE ) ) ) * [FX Rate to Reporting]
		formatString: #,##0
		displayFolder: 11 Targets
		lineageTag: 0170384c-edc0-5bce-8add-89f25a23bfcf

	measure 'Target Gross Churn %' = DIVIDE ( CALCULATE ( AVERAGE ( fact_targets_month[target_value] ), fact_targets_month[kpi] = "gross_monthly_churn_pct" ), 100 )
		formatString: 0.0%
		displayFolder: 11 Targets
		lineageTag: 1b29054a-1de2-5428-9fb8-b5f5779c11c0

	/// Higher is better.
	measure 'Paid Active Subscribers vs Target %' = DIVIDE ( [Paid Active Subscribers (EoP)] - [Target Paid Active Subscribers], [Target Paid Active Subscribers] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 11 Targets
		lineageTag: 463f1ba3-c105-5a54-a7c6-10153701fe44

	/// Higher is better.
	measure 'MRR vs Target %' = DIVIDE ( [MRR (Latest)] - [Target MRR], [Target MRR] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 11 Targets
		lineageTag: db6a239f-4f8d-506b-8328-9901dfc873ed

	/// LOWER is better — a negative value is good (below target).
	measure 'Gross Churn vs Target (pp)' = [Gross Monthly Churn %] - [Target Gross Churn %]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 11 Targets
		lineageTag: 4d78f321-d439-5145-8951-2715532a6e55

	/// Target CAC US$22. LOWER is better.
	measure 'Blended CAC vs Target %' = DIVIDE ( [Blended CAC] - 22, 22 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 11 Targets
		lineageTag: 6b1f578f-5f88-50ea-bc5c-e74281560198

	/// Cumulative gap to plan from window-month 34 onward — the board scoreboard.
	measure 'Subscribers Lost vs Plan (since shift)' =
			CALCULATE (
			    [Target Paid Active Subscribers] - [Paid Active Subscribers (EoP)],
			    REMOVEFILTERS ( dim_date ),
			    dim_date[window_month_idx] >= 33
			)
		formatString: #,##0
		displayFolder: 11 Targets
		lineageTag: be9d730d-f181-5452-80e6-4cc0c1aa3ec2

	/// Affiliate + partner-bundle share of new subscribers.
	measure '% New via Low-Quality Channels' =
			DIVIDE (
			    CALCULATE ( [New Subscribers],
			        dim_subscriber[acquisition_channel] IN { "affiliate", "partner_bundle" } ),
			    [New Subscribers]
