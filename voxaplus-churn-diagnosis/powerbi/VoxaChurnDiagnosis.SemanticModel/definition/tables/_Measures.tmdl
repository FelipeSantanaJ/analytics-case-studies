	measure 'MRR PY' = CALCULATE ( [MRR], TREATAS ( SELECTCOLUMNS ( VALUES ( dim_date[abs_month] ), "abs_month", dim_date[abs_month] - 12 ), dim_date[abs_month] ) )
		formatString: #,##0
