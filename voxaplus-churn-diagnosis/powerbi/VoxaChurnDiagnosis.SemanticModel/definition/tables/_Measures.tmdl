	measure 'MRR MoM %' = DIVIDE ( [MRR] - CALCULATE ( [MRR], FILTER ( ALL ( dim_date ), dim_date[abs_month] = MAX ( dim_date[abs_month] ) - 1 ) ), CALCULATE ( [MRR], FILTER ( ALL ( dim_date ), dim_date[abs_month] = MAX ( dim_date[abs_month] ) - 1 ) ) )
