	measure 'Total Revenue PY' = CALCULATE ( [Total Revenue], TREATAS ( SELECTCOLUMNS ( VALUES ( dim_date[abs_month] ), "abs_month", dim_date[abs_month] - 12 ), dim_date[abs_month] ) )
