model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation PBI_QueryOrder = ["dim_courier", "dim_customer", "dim_date", "dim_incentive_campaign", "dim_restaurant", "dim_time_block", "dim_zone", "dim_zone_adjacency", "fact_courier_shift_block", "fact_delivery", "fact_experiment_zone_block_week", "fact_experiment_zone_day", "fact_incentive_assignment", "fact_order", "fact_zone_hour", "_Measures", "pDataFolder"]

	annotation __PBI_TimeIntelligenceEnabled = 0

	annotation PBI_ProTooling = ["DevMode"]
