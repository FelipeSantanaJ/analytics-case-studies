	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_delivered] = TRUE )
		formatString: #,0.0" d"
		displayFolder: 10 Logistics & Fulfillment
		lineageTag: 5a038055-0c50-5922-a8b8-7f0d6ba66b3e

	measure 'Avg Ship Days' = AVERAGE ( fact_orders[ship_days] )
		formatString: #,0.0" d"
		displayFolder: 10 Logistics & Fulfillment
