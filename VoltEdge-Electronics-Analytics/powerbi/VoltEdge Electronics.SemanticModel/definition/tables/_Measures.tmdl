	measure 'Funnel Value' =
			SWITCH (
			    SELECTEDVALUE ( 'Funnel Stage'[Stage] ),
			    "Sessions", [Sessions],
			    "Add-to-Cart", [Add-to-Carts],
			    "Cart", [Carts Created],
			    "Orders", [Orders],
			    BLANK ()
			)
		formatString: #,0
