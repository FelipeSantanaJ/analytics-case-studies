	measure 'Shipping Fee Revenue (USD)' =
			(
			CALCULATE ( SUM ( fact_orders[shipping_fee_usd] ), KEEPFILTERS ( fact_orders[is_cancelled] = FALSE ) )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 10 Logistics & Fulfillment
		lineageTag: d7f70034-6c08-5611-bb7a-168d9f192b0a

	measure 'Shipping Cost Recovery %' = DIVIDE ( [Shipping Fee Revenue (USD)], [Shipping Cost (USD)] )
