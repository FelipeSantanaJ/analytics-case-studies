	measure 'Inventory Value (USD)' =
			(
			VAR _lastSnap = CALCULATE ( MAX ( fact_inventory_snapshot[snapshot_date_key] ), ALLSELECTED ( dim_date ) )
			RETURN CALCULATE ( SUM ( fact_inventory_snapshot[inventory_value_usd] ), fact_inventory_snapshot[snapshot_date_key] = _lastSnap )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: ad439fc6-20e5-508b-8c36-e9eda96dae31

	measure 'Inventory Value (Month-End) (USD)' =
			(
			VAR _snap = MAX ( fact_inventory_snapshot[snapshot_date_key] )
			RETURN CALCULATE ( SUM ( fact_inventory_snapshot[inventory_value_usd] ),
			    fact_inventory_snapshot[snapshot_date_key] = _snap )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 057a4b46-a2db-5235-aab1-a99bc19443d7

	measure 'Weeks of Cover (Month-End)' =
			VAR _snap = MAX ( fact_inventory_snapshot[snapshot_date_key] )
			RETURN CALCULATE (
			    DIVIDE ( SUM ( fact_inventory_snapshot[units_on_hand] ),
			             SUM ( fact_inventory_snapshot[avg_weekly_units_sold] ) ),
			    fact_inventory_snapshot[snapshot_date_key] = _snap )
		formatString: #,0.0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 0d18ae2e-38c9-5248-875f-9445a5caa73a

	measure 'Inventory in Transit (USD)' =
			(
			VAR _lastSnap = CALCULATE ( MAX ( fact_inventory_snapshot[snapshot_date_key] ), ALLSELECTED ( dim_date ) )
			RETURN CALCULATE ( SUMX ( fact_inventory_snapshot, fact_inventory_snapshot[units_in_transit] * fact_inventory_snapshot[moving_avg_cost_usd] ), fact_inventory_snapshot[snapshot_date_key] = _lastSnap )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 6048fdfd-8f62-5872-a701-4c64e5d134ca

	measure 'Avg Inventory Value (USD)' =
			(
			AVERAGEX ( VALUES ( fact_inventory_snapshot[snapshot_date_key] ), CALCULATE ( SUM ( fact_inventory_snapshot[inventory_value_usd] ) ) )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 403ff0b5-39f8-5a21-ac78-27c9a2b938d5

	measure 'COGS Trailing 12M (USD)' = CALCULATE ( [COGS (USD)], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ) )
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 02f57558-d5cf-5c45-9b0f-2af92b9ee9cf

	measure 'Inventory Turnover' = DIVIDE ( [COGS Trailing 12M (USD)], [Avg Inventory Value (USD)] )
		formatString: #,0.0"x"
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 377a16aa-66f5-56fb-af45-747a48930524

	measure 'DIO (days)' = DIVIDE ( [Avg Inventory Value (USD)] * COUNTROWS ( VALUES ( dim_date[date] ) ), [COGS (USD)] )
		formatString: #,0.0" d"
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 7f671fcb-0975-5ffd-9252-281dc1c4aa61

	measure 'Accounts Payable Open (USD)' =
			(
			VAR _asOfKey = CALCULATE ( MAX ( dim_date[date_key] ), ALLSELECTED ( dim_date ) )
			RETURN
			CALCULATE (
			    SUM ( fact_purchase_orders[po_value_usd] ),
			    FILTER (
			        ALL ( fact_purchase_orders ),
			        fact_purchase_orders[actual_receipt_date_key] <= _asOfKey
			            && fact_purchase_orders[supplier_paid_date_key] > _asOfKey
			    ),
			    REMOVEFILTERS ( dim_date )
			)
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: a89adc66-4f5c-586b-a0e6-d014f80e0c2d

	measure 'DPO (days)' = DIVIDE ( [Accounts Payable Open (USD)] * COUNTROWS ( VALUES ( dim_date[date] ) ), [COGS (USD)] )
		formatString: #,0.0" d"
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 3b74947c-2a91-5338-9ab9-919b080dafac

	measure 'Accounts Receivable Open (USD)' = [Receivables Outstanding (USD)]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 7c727b78-8590-5664-993d-1fa87d464afe

	measure 'Cash Conversion Cycle (days)' = [DIO (days)] + [DSO (days)] - [DPO (days)]
		formatString: #,0.0" d"
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 9069e330-f1f5-5e1b-9be8-6467dcbad764

	measure 'Weeks of Cover' =
			VAR _lastSnap = CALCULATE ( MAX ( fact_inventory_snapshot[snapshot_date_key] ), ALLSELECTED ( dim_date ) )
			RETURN CALCULATE (
			    DIVIDE ( SUM ( fact_inventory_snapshot[units_on_hand] ), SUM ( fact_inventory_snapshot[avg_weekly_units_sold] ) ),
			    fact_inventory_snapshot[snapshot_date_key] = _lastSnap )
		formatString: #,0.0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 28e60ba6-5370-5bdb-9886-4967a01286c0

	measure 'Supplier Spend (USD)' =
			(
			CALCULATE ( SUM ( fact_purchase_orders[po_value_usd] ),
			    USERELATIONSHIP ( fact_purchase_orders[actual_receipt_date_key], dim_date[date_key] ) )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 472919fb-746a-59bc-85ce-8dd203bc8cc8

	measure 'Working Capital Tied Up (USD)' = [Inventory Value (USD)] + [Accounts Receivable Open (USD)] - [Accounts Payable Open (USD)]
		formatString: "$"#,0
		displayFolder: 11 Working Capital & Inventory
		lineageTag: 2ddfd3ec-1892-5f84-94a1-beef19fd189f

	measure 'Customers with Orders' = CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_key] ), KEEPFILTERS ( fact_orders[is_cancelled] = FALSE ) )
		formatString: #,0
		displayFolder: 12 CRM & Retention
		lineageTag: 1293608b-8448-5af9-a0fe-43783296d36c

	measure 'Active Customers (12M)' = CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_key] ), DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ), KEEPFILTERS ( fact_orders[is_cancelled] = FALSE ) )
		formatString: #,0
		displayFolder: 12 CRM & Retention
		lineageTag: b50f156b-ffed-564b-b8b4-d8f24991c061

	measure 'Avg Orders per Customer' = DIVIDE ( [Orders], [Customers with Orders] )
		formatString: #,0.0
		displayFolder: 12 CRM & Retention
		lineageTag: 0d963bcb-c3f3-5839-80eb-bc515b88849c

	measure 'Repeat Purchase Rate %' =
			VAR _cust = CALCULATETABLE ( VALUES ( fact_orders[customer_key] ), fact_orders[is_cancelled] = FALSE )
			VAR _repeat = FILTER ( _cust, CALCULATE ( DISTINCTCOUNT ( fact_orders[order_id] ) ) > 1 )
			RETURN DIVIDE ( COUNTROWS ( _repeat ), COUNTROWS ( _cust ) )
		formatString: 0.0%
		displayFolder: 12 CRM & Retention
		lineageTag: dc4ffc46-85ff-53e3-8b6d-48cd7d4f646e

	measure 'CLV Gross Profit (USD)' = DIVIDE ( [Gross Profit (USD)], [Customers with Orders] )
		formatString: "$"#,0.00
		displayFolder: 12 CRM & Retention
		lineageTag: 0a0abcd6-42ec-5174-8bda-91585be6225c

	measure 'New Customers (acq month)' = DISTINCTCOUNT ( dim_customer[customer_id] )
		formatString: #,0
		displayFolder: 12 CRM & Retention
		lineageTag: fbd8c60b-6c61-563c-8f6f-56b84764de9b

	measure 'Repeat Customers (lifetime)' = CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_id] ), dim_customer[is_repeat_customer] = TRUE )
		formatString: #,0
		displayFolder: 12 CRM & Retention
		lineageTag: 4aea30f2-a1fe-5d18-906e-95b21b520eee

	measure 'Churned Customers' = CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_id] ), dim_customer[customer_status] = "Churned" )
		formatString: #,0
		displayFolder: 12 CRM & Retention
		lineageTag: cfae460b-c284-5ea9-bcdf-765a02f0314f

	measure 'Gold Tier Revenue %' = DIVIDE ( CALCULATE ( [Net Revenue (USD)], dim_customer[loyalty_tier] = "Gold" ), [Net Revenue (USD)] )
		formatString: 0.0%
		displayFolder: 12 CRM & Retention
		lineageTag: 2b203104-94f0-5d16-89bb-b40b10eace59

	measure 'Support Tickets' = DISTINCTCOUNT ( fact_support_tickets[ticket_id] )
		formatString: #,0
		displayFolder: 13 Support & Returns
		lineageTag: b440c0f2-9c07-5922-90e3-708fdbb6ff5f

	measure 'Avg Resolution Hours' = AVERAGE ( fact_support_tickets[resolution_hours] )
		formatString: #,0.0
		displayFolder: 13 Support & Returns
		lineageTag: 893e9922-9416-580e-9cfd-9bcf6a2629cb

	measure 'First Contact Resolution %' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( fact_support_tickets[ticket_id] ), fact_support_tickets[first_contact_resolution] = TRUE ), [Support Tickets] )
		formatString: 0.0%
		displayFolder: 13 Support & Returns
		lineageTag: feebbfab-61a3-5ad2-95c8-089645c6bccb

	measure 'Avg CSAT' = AVERAGE ( fact_support_tickets[csat] )
		formatString: #,0.00
		displayFolder: 13 Support & Returns
		lineageTag: 1f33d15f-6bbd-57ea-b778-3a2c45abeb59

	measure 'Tickets per 1000 Orders' = DIVIDE ( [Support Tickets], [Orders] ) * 1000
		formatString: #,0.0
		displayFolder: 13 Support & Returns
		lineageTag: f238853c-3283-53ff-925f-5a915cd46dd4

	measure 'Returned Units' = SUM ( fact_returns[returned_qty] )
		formatString: #,0
		displayFolder: 13 Support & Returns
		lineageTag: a1338028-b4ed-5c6a-9221-94596211e0f8

	measure 'Return Value (USD)' =
			(
			SUM ( fact_returns[refund_amount_usd] )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 13 Support & Returns
		lineageTag: 6e9347a8-09b4-5af1-a5e6-e52024dfd751

	measure 'Return Rate %' = DIVIDE ( CALCULATE ( SUM ( fact_order_lines[returned_qty] ), KEEPFILTERS ( fact_order_lines[order_status] <> "cancelled" ) ), [Units Sold] )
		formatString: 0.0%
		displayFolder: 13 Support & Returns
		lineageTag: a43bb81c-f510-55b4-a3de-a3b06cec5e8b

	measure 'Restock Rate %' = DIVIDE ( CALCULATE ( SUM ( fact_returns[returned_qty] ), fact_returns[restocked] = TRUE ), [Returned Units] )
		formatString: 0.0%
		displayFolder: 13 Support & Returns
		lineageTag: 7a30cfec-e601-5805-8279-60a0ba3ab3ac

	column _placeholder
		dataType: int64
		isHidden
		lineageTag: 2211c6f5-00d3-5039-8801-24aed387e260
		summarizeBy: none
		sourceColumn: _placeholder

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		queryGroup: parameters
		source =
				let
				    Source = #table(type table [_placeholder = Int64.Type], {{1}})
				in
				    Source

	annotation PBI_ResultType = Table

