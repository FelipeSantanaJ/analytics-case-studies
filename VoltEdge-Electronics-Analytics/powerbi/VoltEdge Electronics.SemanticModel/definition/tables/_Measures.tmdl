	measure 'On-Time Delivery %' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( fact_orders[order_id] ), fact_orders[is_on_time] = TRUE ), [Orders Delivered] )
		formatString: 0.0%
		displayFolder: 10 Logistics & Fulfillment
		lineageTag: 77d41647-4efc-5b80-b727-6132510c7bde

	measure 'Late Deliveries' = CALCULATE ( DISTINCTCOUNT ( fact_orders[order_id] ), fact_orders[is_late] = TRUE, fact_orders[is_delivered] = TRUE )
		formatString: #,0
		displayFolder: 10 Logistics & Fulfillment
		lineageTag: f12509e4-40cb-5719-b9f1-a13dcb020185

	measure 'Perfect Order Rate %' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( fact_orders[order_id] ), fact_orders[is_perfect_order] = TRUE ), [Orders] )
		formatString: 0.0%
		displayFolder: 10 Logistics & Fulfillment
		lineageTag: b5a69c47-09ce-56b6-b60c-41e9c4679e92

	measure 'Shipping Cost (USD)' =
			(
			CALCULATE ( SUM ( fact_orders[shipping_cost_usd] ), KEEPFILTERS ( fact_orders[is_cancelled] = FALSE ) )
			) * [FX Rate to Reporting Currency]
		formatString: "$"#,0
		displayFolder: 10 Logistics & Fulfillment
		lineageTag: 75b9a63f-a5b3-5739-8489-8658bc867947

