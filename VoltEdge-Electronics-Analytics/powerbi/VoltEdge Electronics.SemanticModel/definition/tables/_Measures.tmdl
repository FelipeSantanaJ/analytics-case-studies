		lineageTag: 4bf322bf-583c-5027-8f7c-14ac3b1dc408

	measure 'Marketing Spend PY (USD)' = CALCULATE ( [Marketing Spend (USD)], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: "$"#,0
		displayFolder: 08 Marketing & Acquisition
		lineageTag: c6fc4dd3-90c4-5110-9f08-9e8588e63800

	measure 'Marketing Spend YoY %' = DIVIDE ( [Marketing Spend (USD)] - [Marketing Spend PY (USD)], [Marketing Spend PY (USD)] )
